@startuml myGraph_flow
skinparam usecaseFontSize 14
skinparam usecaseStereotypeFontSize 12
skinparam hexagonFontSize 14
skinparam hexagonStereotypeFontSize 12
title "myGraph flow"
footer

powered by spring-ai-alibaba
end footer
circle start<<input>> as __START__
circle stop as __END__
usecase "authNode"<<Node>>
usecase "imageAnalysisNode"<<Node>>
package sendMessageCompiledGraph [
{{
circle " " as __START__
circle exit as __END__
usecase "userWantToNode"<<Node>>
usecase "messageGenerateNode"<<Node>>
usecase "formatOutPutLlmNode"<<Node>>
usecase "botStatusSearchNode"<<Node>>
usecase "memoryVectorSearchNode"<<Node>>
usecase "graphSearchNode"<<Node>>
usecase "roleReversalCheckLlmNode"<<Node>>
usecase "memoryCheckLlmNode"<<Node>>
usecase "checkAggregateNode"<<Node>>
usecase "interactionCheckLlmNode"<<Node>>
usecase "dispatchToChecks"<<Node>>
usecase "sendMessageNode"<<Node>>
hexagon "check state" as condition1<<Condition>>
hexagon "check state" as condition2<<Condition>>
"__START__" -down-> "userWantToNode"
"userWantToNode" -down-> "botStatusSearchNode"
"userWantToNode" -down-> "memoryVectorSearchNode"
"userWantToNode" -down-> "graphSearchNode"
"botStatusSearchNode" -down-> "messageGenerateNode"
"memoryVectorSearchNode" -down-> "messageGenerateNode"
"graphSearchNode" -down-> "messageGenerateNode"
"messageGenerateNode" .down.> "condition1"
"condition1" .down.> "dispatchToChecks": "next"
'"messageGenerateNode" .down.> "dispatchToChecks": "next"
"condition1" .down.> "__END__": "end"
'"messageGenerateNode" .down.> "__END__": "end"
"dispatchToChecks" -down-> "memoryCheckLlmNode"
"dispatchToChecks" -down-> "roleReversalCheckLlmNode"
"dispatchToChecks" -down-> "interactionCheckLlmNode"
"roleReversalCheckLlmNode" -down-> "checkAggregateNode"
"memoryCheckLlmNode" -down-> "checkAggregateNode"
"interactionCheckLlmNode" -down-> "checkAggregateNode"
"checkAggregateNode" .down.> "condition2"
"condition2" .down.> "messageGenerateNode"
'"checkAggregateNode" .down.> "messageGenerateNode"
"condition2" .down.> "formatOutPutLlmNode": "transformTagMessageNode"
'"checkAggregateNode" .down.> "formatOutPutLlmNode": "transformTagMessageNode"
"formatOutPutLlmNode" -down-> "sendMessageNode"
"sendMessageNode" -down-> "__END__"
}}
]
hexagon "check state" as condition1<<Condition>>
"__START__" -down-> "authNode"
"authNode" .down.> "condition1"
"condition1" .down.> "imageAnalysisNode": "true"
'"authNode" .down.> "imageAnalysisNode": "true"
"condition1" .down.> "__END__": "false"
'"authNode" .down.> "__END__": "false"
"imageAnalysisNode" -down-> "sendMessageCompiledGraph"
"sendMessageCompiledGraph" -down-> "__END__"
@enduml
